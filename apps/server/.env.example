PORT=3000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/feature-tracker

# Upstash Redis URL (from https://console.upstash.com)
# Format: redis://<default>:<password>@<host>:<port>
REDIS_URL=redis://:your-upstash-password@your-upstash-host.upstash.io:6379

JWT_SECRET=your-secret-key-here

ACCESS_TOKEN_SECRET_KEY=your-access-token-secret
ACCESS_TOKEN_EXPIRATION=1h
REFRESH_TOKEN_SECRET_KEY=your-refresh-token-secret
REFRESH_TOKEN_EXPIRATION=7d